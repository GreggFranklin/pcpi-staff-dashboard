/* ------------------------------------------------------------------
 * PCPI Polygraph GF Tools - Entries Table Styles
 * ------------------------------------------------------------------ */

.pcpi-gf-table{
	width:100%;
	border-collapse:collapse;
	border:1px solid #ddd;
	font-family:Arial, sans-serif;
}

.pcpi-gf-table thead{
	background:#f9f9f9;
}

.pcpi-gf-table th,
.pcpi-gf-table td{
	padding:10px;
	border:1px solid #ddd;
}

.pcpi-gf-table .pcpi-gf-actions-col{
	width:500px;
	text-align:center;
}

.pcpi-gf-table .pcpi-actions-td{
	text-align:center;
}

.pcpi-gf-table .pcpi-actions{
	display:flex;
	gap:6px;
	justify-content:center;
	align-items:center;
	flex-wrap:wrap;
}

/* Row striping (matches original alternating colors) */
.pcpi-gf-table .pcpi-row-even{ background:#f9f9f9; }
.pcpi-gf-table .pcpi-row-odd { background:#fff; }

/* ------------------------------------------------------------------
 * Buttons (scoped + stronger than theme styles)
 * ------------------------------------------------------------------ */
.pcpi-gf-table .gf-action-btn{
	transition:all .25s ease;
	box-shadow:0 1px 2px rgba(0,0,0,.25);
	cursor:pointer;

	display:inline-block;
	padding:5px 9px;
	border-radius:3px;
	text-decoration:none;

	border:0;
	font-size:13px;
	line-height:1.2;
	font-family:Arial, sans-serif;

	/* Prevent theme from forcing weird defaults */
	background:transparent;
	color:inherit;
}

/* Hover lift */
.pcpi-gf-table .gf-action-btn:hover{
	transform:translateY(-3px);
	box-shadow:0 4px 8px rgba(0,0,0,.25);
	text-decoration:none;
}

/* Make sure links never inherit theme hover colors */
.pcpi-gf-table a.gf-action-btn,
.pcpi-gf-table a.gf-action-btn:visited{
	text-decoration:none;
}

.pcpi-gf-table a.gf-action-btn:hover,
.pcpi-gf-table a.gf-action-btn:focus{
	text-decoration:none;
	outline:none;
}

/* Disabled */
.pcpi-gf-table .gf-disabled,
.pcpi-gf-table .gf-action-btn:disabled{
	cursor:not-allowed !important;
	box-shadow:none !important;
	transform:none !important;
	opacity:.9;
}

/* ------------------------------------------------------------------
 * Button color mappings (lock both normal + hover)
 * ------------------------------------------------------------------ */
.pcpi-gf-table .pcpi-btn-review,
.pcpi-gf-table .pcpi-btn-review:visited,
.pcpi-gf-table .pcpi-btn-review:hover,
.pcpi-gf-table .pcpi-btn-review:focus{
	background:#2ea83a;
	color:#fff;
}

.pcpi-gf-table .pcpi-btn-summary,
.pcpi-gf-table .pcpi-btn-summary:visited,
.pcpi-gf-table .pcpi-btn-summary:hover,
.pcpi-gf-table .pcpi-btn-summary:focus{
	background:#475569;
	color:#fff;
}

.pcpi-gf-table .pcpi-btn-resend,
.pcpi-gf-table .pcpi-btn-resend:hover,
.pcpi-gf-table .pcpi-btn-resend:focus{
	background:#2271b1;
	color:#fff;
}

.pcpi-gf-table .pcpi-btn-delete,
.pcpi-gf-table .pcpi-btn-delete:hover,
.pcpi-gf-table .pcpi-btn-delete:focus{
	background:#d63638;
	color:#fff;
}

.pcpi-gf-table .pcpi-btn-disabled,
.pcpi-gf-table .pcpi-btn-disabled:hover,
.pcpi-gf-table .pcpi-btn-disabled:focus{
	background:#ccc;
	color:#666;
}

/* -------------------------------------------------
 * Send PDF — clean, consistent with other action buttons
 * ------------------------------------------------- */
.gf-action-btn.pcpi-btn-sendpdf {
	background-color: #72aee6;
	color: #fff;
	border: 1px solid #72aee6;
}

.gf-action-btn.pcpi-btn-sendpdf:hover,
.gf-action-btn.pcpi-btn-sendpdf:focus,
.gf-action-btn.pcpi-btn-sendpdf:active {
	background-color: #72aee6;
	color: #fff;
	border-color: #72aee6;
	box-shadow: none;
}

/* Disabled */
.gf-action-btn.pcpi-btn-sendpdf.gf-disabled,
.gf-action-btn.pcpi-btn-sendpdf[disabled] {
	background-color: #d6e6f6;
	border-color: #d6e6f6;
	color: #7a9bbd;
	cursor: not-allowed;
}

/* ------------------------------------------------------------------
 * Debug box
 * ------------------------------------------------------------------ */
.pcpi-gf-table .pcpi-debug{
	margin-top:6px;
	font-size:11px;
	line-height:1.3;
	color:#444;
	text-align:left;
	max-width:520px;
	white-space:normal;
	background:#fff;
	border:1px solid #ddd;
	padding:6px;
	border-radius:4px;
}

/* ------------------------------------------------------------------
   PCPI — Compact right-aligned pagination (like: « 1 2 3 4 5 »)
   ------------------------------------------------------------------ */
.pcpi-pagination {
	display: flex;
	justify-content: flex-end;
	margin-top: 12px;
}

.pcpi-pagination-list {
	display: flex;
	gap: 6px;
	list-style: none;
	padding: 0;
	margin: 0;
}

.pcpi-page-item a,
.pcpi-page-item span {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	min-width: 30px;
	height: 30px;
	font-size: 13px;
	line-height: 1;
	border: 1px solid rgba(0,0,0,.25);
	border-radius: 6px;
	background: #fff;
	color: #333;
	text-decoration: none;
	user-select: none;
}

.pcpi-page-item a:hover {
	background: rgba(0,0,0,.04);
}

.pcpi-page-item.is-active span {
	background: #3ca54a;
	border-color: #3ca54a;
	color: #fff;
	font-weight: 600;
}

.pcpi-page-item.is-disabled span {
	opacity: .45;
	cursor: not-allowed;
}

/* Ensure the table is a block that can define width */
.pcpi-gf-table {
	width: 100%;
}

/* Pagination aligns to the right edge of the table width */
.pcpi-pagination {
	display: block;
	width: 100%;
	margin-top: 12px;
	text-align: right; /* key: matches table width */
}

/* Compact pager */
.pcpi-pagination-list {
	display: inline-flex;
	gap: 6px;
	list-style: none;
	padding: 0;
	margin: 0;
}

.pcpi-page-item a,
.pcpi-page-item span {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	min-width: 30px;
	height: 30px;
	font-size: 13px;
	line-height: 1;
	border: 1px solid rgba(0,0,0,.25);
	border-radius: 6px;
	background: #fff;
	color: #333;
	text-decoration: none;
	user-select: none;
}

.pcpi-page-item a:hover {
	background: rgba(0,0,0,.04);
}

/* Active page color */
.pcpi-page-item.is-active span {
	background: #2b6cb0;
	border-color: #2b6cb0;
	color: #fff;
	font-weight: 600;
}

.pcpi-page-item.is-disabled span {
	opacity: .45;
	cursor: not-allowed;
}

